<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Everything on screen is Compose; the window only needs the page colour. -->
    <style name="Theme.SuperAgents" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The launch screen: the mascot on its brick circle, on the page colour; the intro takes over from it. -->
    <style name="Theme.SuperAgents.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/page</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brick</item>
        <item name="postSplashScreenTheme">@style/Theme.SuperAgents</item>
    </style>
</resources>
